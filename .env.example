# Copy to .env if you need to override the defaults. Never commit credentials.
MUSIC_PORT=8787
MUSIC_DATA_DIR=.local
MUSIC_BACKUP_DIR=backups
GOOGLE_CLIENT_SECRET_FILE=.local/client-secret.json

# Optional: only needed to enable direct Spotify sync execution. All three
# must be set together, or all left unset. There is no in-app Spotify connect
# flow yet; obtain these out-of-band (see README.md) and never commit them.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_REFRESH_TOKEN=
